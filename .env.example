OPENROUTER_API_KEY=your_openrouter_api_key_here
EDITOR=nano

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
# Add authorized redirect URI: {BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SECRET_KEY=generate-a-random-string-here
BASE_URL=http://localhost:8000

# GA4 Data API (blog post analytics) — uses the signed-in user's own Google OAuth
# token (analytics.readonly scope, requested by the same GOOGLE_CLIENT_ID/SECRET
# above). No service account. Each user needs Viewer access on this GA4 property.
GA4_PROPERTY_ID=316810679
